digraph Topology {
  rankdir=TB;
  fontname="Helvetica";
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=12, color="#334155"];
  graph [fontname="Helvetica", fontsize=14];

  subgraph cluster_a {
    label="Topology A — one workspace repo (small / single delivery)";
    style="rounded,filled"; fillcolor="#f1f5f9"; color="#64748b"; fontcolor="#0f172a"; margin=16;
    a_pub [label="pubspec.yaml (workspace + melos)", fillcolor="#ffffff"];
    a_dom [label="packages/thing_domain\n(entities, contracts, failures)", fillcolor="#dcfce7"];
    a_uc  [label="packages/thing_usecases\n(application layer)", fillcolor="#dbeafe"];
    a_d1  [label="packages/thing_datasource_drift\n(adapter 1)", fillcolor="#fef3c7"];
    a_d2  [label="packages/thing_datasource_sembast\n(adapter 2)", fillcolor="#fef3c7"];
    a_d3  [label="packages/thing_datasource_memory\n(adapter 3 + tests)", fillcolor="#fef3c7"];
    a_app [label="apps/thing_flutter (UI ring)", fillcolor="#e2e8f0"];
    a_pub -> a_dom -> a_uc -> a_d1 -> a_d2 -> a_d3 -> a_app [style=invis, arrowhead=none];
  }

  subgraph cluster_b {
    label="Topology B — core repo + UI repo (default for CLI + Flutter)";
    style="rounded,filled"; fillcolor="#f1f5f9"; color="#64748b"; fontcolor="#0f172a"; margin=16;
    b_pub [label="core/ pubspec.yaml (workspace + melos)", fillcolor="#ffffff"];
    b_dom [label="core/ packages/thing_domain\n(entities, contracts, failures)", fillcolor="#dcfce7"];
    b_uc  [label="core/ packages/thing_usecases\n(shared facade)", fillcolor="#dbeafe"];
    b_d1  [label="core/ packages/thing_datasource_drift\n(adapter 1)", fillcolor="#fef3c7"];
    b_d2  [label="core/ packages/thing_datasource_sembast\n(adapter 2)", fillcolor="#fef3c7"];
    b_d3  [label="core/ packages/thing_datasource_memory\n(adapter 3 + tests)", fillcolor="#fef3c7"];
    b_cli [label="core/ packages/thing_cli (CLI)", fillcolor="#fae8ff"];
    b_ui  [label="ui/ thing_flutter\n(separate repo, git dep on core)", fillcolor="#e2e8f0"];
    b_pub -> b_dom -> b_uc -> b_d1 -> b_d2 -> b_d3 -> b_cli -> b_ui [style=invis, arrowhead=none];
  }
}
